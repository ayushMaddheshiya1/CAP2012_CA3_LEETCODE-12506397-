#include <iostream>
using namespace std;

class Solution 
{
public:
    int search(int arr[], int n, int target) 
    {
        int low = 0;
        int high = n - 1;

        while(low <= high)
        {
            int mid = low + (high - low) / 2;

            if(arr[mid] == target)
            {
                return mid;
            }
            else if(arr[mid] < target)
            {
                low = mid + 1;
            }
            else
            {
                high = mid - 1;
            }
        }

        return -1;
    }
};

int main()
{
    Solution obj;

    int arr[] = {2, 4, 6, 8, 10, 12, 14};
    int n = 7;
    int target = 10;

    int result = obj.search(arr, n, target);

    if(result != -1)
    {
        cout << "Element found at index: " << result;
    }
    else
    {
        cout << "Element not found";
    }

    return 0;
}
